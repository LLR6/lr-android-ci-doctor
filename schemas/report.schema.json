{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Android CI Doctor report",
  "type": "object",
  "required": [
    "schema",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "lr-ci-doctor/v1"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "fix",
          "priority",
          "first_line",
          "evidence",
          "occurrences"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "first_line": {
            "type": "integer",
            "minimum": 1
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "line",
                "text"
              ]
            }
          }
        }
      }
    }
  }
}
